# Example Bgp Networks - CACHE - bond0.3001 - AS64510 - kernel table 201
# generated by ix-bird; edit the customer yaml, not this file
define EXAMPLEBGPNETWORKS_CACHE_PREFIXES = [ 203.0.113.0/24 ];

ipv4 table t_cache_examplebgpnetworks;

# what we announce: the service subnets (withdrawn by BIRD if the next hop goes away)
protocol static ann_cache_examplebgpnetworks {
    ipv4 { table t_cache_examplebgpnetworks; };
    route 198.51.100.0/27 via 192.0.2.1;
    route 198.51.100.64/27 via 192.0.2.1;
}

# fallback: used only while the BGP route is missing (preference 50 < 100)
protocol static fb_cache_examplebgpnetworks {
    ipv4 { table t_cache_examplebgpnetworks; preference 50; };
    route 203.0.113.0/24 via 10.30.1.2;
}

filter in_cache_examplebgpnetworks {
    if net = 0.0.0.0/0 then reject;          # first term: never a default
    if net.len > 24 then reject;
    if net ~ IXBIRD_DENY then reject;
    if bgp_path.first != 64510 then reject;
    if net ~ EXAMPLEBGPNETWORKS_CACHE_PREFIXES then accept;
    reject;
}

filter out_cache_examplebgpnetworks {
    if net = 0.0.0.0/0 then reject;
    if source = RTS_STATIC && net ~ [ 198.51.100.0/27, 198.51.100.64/27 ] then accept;
    reject;
}

protocol bgp bgp_cache_examplebgpnetworks {
    description "Example Bgp Networks AS64510 - CACHE - bond0.3001";
    local 10.30.1.1 as 64500;
    neighbor 10.30.1.2 as 64510;
    ipv4 {
        table t_cache_examplebgpnetworks;
        import filter in_cache_examplebgpnetworks;
        export filter out_cache_examplebgpnetworks;
        import keep filtered on;
        next hop self;
    };
}

# writes ONLY kernel table 201; never main, never routes it did not create
protocol kernel krt_cache_examplebgpnetworks {
    kernel table 201;
    learn off;
    persist on;
    metric 32;
    ipv4 {
        table t_cache_examplebgpnetworks;
        import none;
        export where net ~ EXAMPLEBGPNETWORKS_CACHE_PREFIXES;
    };
}
